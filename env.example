PORT=3000
NODE_ENV=development

# URL pública do site (sem barra no final). Em produção: https://seudominio.com
BASE_URL=http://localhost:3000

# Discord Developer Portal > sua aplicação > OAuth2
# Cadastre em "Redirects": BASE_URL + /auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# IDs do Discord (separados por vírgula) de quem pode aprovar missões e esconder cartinhas
ADMIN_IDS=

# Primeiro dia do evento (AAAA-MM-DD). O fuso usado é America/Sao_Paulo
EVENT_START=2026-12-01

DB_PATH=./data/natal.db

# Atrás de proxy (Nginx, Cloudflare, Render...): defina 1
TRUST_PROXY=

# SÓ em desenvolvimento: força o dia atual do evento (1 a 25). Ignorado em produção.
DEBUG_DAY=
