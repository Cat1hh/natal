{
  "name": "natal-magico-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm --prefix client run build",
    "test": "npm run build && node --test test/*.test.js",
    "test:browser": "npm run build && node test/browser.mjs",
    "audit:deps": "npm audit --audit-level=low && npm --prefix client audit --audit-level=low",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:database": "node scripts/test-database.mjs"
  },
  "dependencies": {
    "@supabase/postgrest-js": "^2.119.2",
    "@supabase/supabase-js": "^2.119.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "wrangler": "^4.166.0"
  }
}
