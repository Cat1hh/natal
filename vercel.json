{
  "version": 2,
  "framework": null,
  "installCommand": "npm install && npm --prefix client install",
  "buildCommand": "npm --prefix client run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/auth/(.*)", "destination": "/api/index.js" },
    { "source": "/comunidade/:slug/natal", "destination": "/natal.html" },
    { "source": "/comunidade/:path*", "destination": "/index.html" }
  ]
}